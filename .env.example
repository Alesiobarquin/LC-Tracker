# Browser configuration, bundled by Vite at build time.
# Configure these for each Vercel environment and redeploy after changes.
VITE_CLERK_PUBLISHABLE_KEY="pk_test_replace_me"

# Supabase Credentials
VITE_SUPABASE_URL="your-supabase-url-here"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key-here"

# Admin UI access. Database RLS controls actual permissions independently.
# In Vercel dashboard env vars, enter raw values without surrounding quotes.
VITE_ADMIN_USER_ID="user_XXXXXXXXXXXX"
# Optional fallback if user IDs differ between auth environments.
VITE_ADMIN_EMAIL="you@example.com"

# Optional error reporting; configure a Sentry project to enable it.
VITE_SENTRY_DSN=""
VITE_APP_VERSION=""
