{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/(dashboard|study-plan|analytics|settings|onboarding|admin|login|sso-callback|timer|recall)(/.*)?",
      "destination": "/app"
    }
  ],
  "functions": {
    "api/*.ts": {
      "maxDuration": 15
    }
  },
  "headers": [
    {
      "source": "/(dashboard|study-plan|analytics|settings|onboarding|admin|login|sso-callback|timer|recall|app)(/.*)?",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }]
    },
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ]
}
